//@version=6
strategy("缠论策略 Chanlun Strategy", overlay=true, default_qty_type=strategy.percent_of_equity,
     default_qty_value=10, initial_capital=100000, currency=currency.USD,
     max_bars_back=5000, pyramiding=0, calc_on_every_tick=false)

// ============================================================================
// INPUT PARAMETERS
// ============================================================================

// --- Chanlun Core Parameters ---
grpCore = "缠论核心参数 / Core Parameters"
i_minBiBars     = input.int(5, "笔最小K线数 / Min Stroke Bars", minval=4, maxval=10, group=grpCore)
i_biAlgo        = input.string("New", "笔算法 / Stroke Algorithm", options=["Old", "New"], group=grpCore)

// --- MACD Parameters ---
grpMACD = "MACD 参数"
i_macdFast      = input.int(12, "MACD Fast", minval=1, group=grpMACD)
i_macdSlow      = input.int(26, "MACD Slow", minval=1, group=grpMACD)
i_macdSignal    = input.int(9, "MACD Signal", minval=1, group=grpMACD)

// --- Visual Settings ---
grpVisual = "显示设置 / Visual Settings"
i_showMerged    = input.bool(false, "显示合并K线 / Show Merged Candles", group=grpVisual)
i_showFractals  = input.bool(true, "显示分型 / Show Fractals", group=grpVisual)
i_showBi        = input.bool(true, "显示笔 / Show Strokes (Bi)", group=grpVisual)
i_showPivot     = input.bool(true, "显示中枢 / Show Pivots", group=grpVisual)
i_showSignals   = input.bool(true, "显示买卖点 / Show Buy/Sell Points", group=grpVisual)
i_showDiverg    = input.bool(true, "显示背驰 / Show Divergence", group=grpVisual)

// --- Color Settings ---
grpColor = "颜色设置 / Colors"
i_colBiUp       = input.color(color.new(color.green, 0), "上升笔 / Up Stroke", group=grpColor)
i_colBiDn       = input.color(color.new(color.red, 0), "下降笔 / Down Stroke", group=grpColor)
i_colPivot      = input.color(color.new(color.orange, 70), "中枢 / Pivot Fill", group=grpColor)
i_colBuy        = input.color(color.new(color.green, 0), "买点 / Buy Signal", group=grpColor)
i_colSell       = input.color(color.new(color.red, 0), "卖点 / Sell Signal", group=grpColor)

// --- Strategy Settings ---
grpStrat = "策略设置 / Strategy Settings"
i_useBuy1       = input.bool(true, "使用第一类买点 / Use B1", group=grpStrat)
i_useBuy2       = input.bool(true, "使用第二类买点 / Use B2", group=grpStrat)
i_useBuy3       = input.bool(true, "使用第三类买点 / Use B3", group=grpStrat)
i_useSell1      = input.bool(true, "使用第一类卖点 / Use S1", group=grpStrat)
i_useSell2      = input.bool(true, "使用第二类卖点 / Use S2", group=grpStrat)
i_useSell3      = input.bool(true, "使用第三类卖点 / Use S3", group=grpStrat)
i_stopLossPct   = input.float(5.0, "止损百分比 / Stop Loss %", minval=0.1, maxval=50.0, step=0.5, group=grpStrat)
i_useTrailing   = input.bool(false, "使用跟踪止损 / Use Trailing Stop", group=grpStrat)
i_trailPct      = input.float(3.0, "跟踪止损% / Trailing Stop %", minval=0.5, maxval=20.0, step=0.5, group=grpStrat)
i_longOnly      = input.bool(false, "仅做多 / Long Only", group=grpStrat)

// --- Performance Settings ---
grpPerf = "性能设置 / Performance"
i_maxCandles    = input.int(500, "最大历史K线 / Max Historical Candles", minval=100, maxval=5000, group=grpPerf)

// ============================================================================
// USER-DEFINED TYPES
// ============================================================================

// Merged candle after inclusion processing
type MergedCandle
    float   hi          // merged high
    float   lo          // merged low
    int     barIdx      // bar_index of the representative bar
    int     startIdx    // first bar included
    int     endIdx      // last bar included
    int     dir         // merge direction: 1=up, -1=down

// Fractal point
type Fractal
    int     ftype       // 1=top, -1=bottom
    float   hi          // fractal high (from merged candle)
    float   lo          // fractal low (from merged candle)
    int     barIdx      // bar_index of the fractal center candle
    bool    confirmed   // whether this fractal is confirmed

// Stroke (Bi) endpoint
type BiPoint
    int     dir         // 1=up stroke ends here (top), -1=down stroke ends here (bottom)
    float   price       // extreme price (high for top, low for bottom)
    float   hi          // high of the fractal
    float   lo          // low of the fractal
    int     barIdx      // bar index
    float   macdArea    // MACD histogram area of this stroke

// Pivot (Zhongshu)
type Pivot
    float   ZG          // pivot high (min of stroke highs in overlap)
    float   ZD          // pivot low (max of stroke lows in overlap)
    int     startIdx    // start bar index
    int     endIdx      // end bar index
    int     strokeCount // number of strokes in pivot
    int     dir         // direction entering pivot: 1=up, -1=down

// Trading signal
type Signal
    int     sigType     // 1=B1, 2=B2, 3=B3, -1=S1, -2=S2, -3=S3
    float   price       // signal price
    int     barIdx      // bar index

// ============================================================================
// GLOBAL STATE ARRAYS
// ============================================================================

var array<MergedCandle> mergedCandles = array.new<MergedCandle>()
var array<Fractal>      fractals      = array.new<Fractal>()
var array<BiPoint>      biPoints      = array.new<BiPoint>()
var array<Pivot>        pivots        = array.new<Pivot>()
var array<Signal>       signals       = array.new<Signal>()

// Drawing arrays for cleanup
var array<line>         biLines       = array.new<line>()
var array<box>          pivotBoxes    = array.new<box>()
var array<label>        sigLabels     = array.new<label>()
var array<label>        fracLabels    = array.new<label>()
var array<label>        divLabels     = array.new<label>()

// ============================================================================
// MACD CALCULATION
// ============================================================================

[macdLine, signalLine, histLine] = ta.macd(close, i_macdFast, i_macdSlow, i_macdSignal)

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

// Check if bar is within processing range
isInRange() =>
    bar_index >= (last_bar_index - i_maxCandles)

// Calculate MACD area between two bar indices (sum of absolute histogram values)
calcMacdArea(int fromBar, int toBar) =>
    float area = 0.0
    int lookback = bar_index - fromBar
    int count = toBar - fromBar
    if lookback >= 0 and count > 0
        for i = 0 to count
            int idx = lookback - i
            if idx >= 0
                area += math.abs(nz(histLine[idx]))
    area

// ============================================================================
// MODULE 1: K-LINE MERGING (包含处理)
// ============================================================================

// We process candles bar-by-bar, maintaining state with var variables
var float  mc_hi       = na      // current merged candle high
var float  mc_lo       = na      // current merged candle low
var int    mc_barIdx   = na      // current merged candle representative bar
var int    mc_startIdx = na      // start of current merge group
var int    mc_dir      = 0       // current direction: 1=up, -1=down
var bool   mc_ready    = false   // a merged candle was just completed

// Output: signals that a new merged candle is finalized
var float  newMC_hi      = na
var float  newMC_lo      = na
var int    newMC_barIdx  = na
var int    newMC_start   = na
var int    newMC_end     = na
var int    newMC_dir     = 0
newMC_ready = false

if isInRange()
    curHi = high
    curLo = low

    if na(mc_hi)
        // First candle
        mc_hi       := curHi
        mc_lo       := curLo
        mc_barIdx   := bar_index
        mc_startIdx := bar_index
    else
        // Check inclusion relationship
        bool curContainsPrev = (curHi >= mc_hi and curLo <= mc_lo)
        bool prevContainsCur = (mc_hi >= curHi and mc_lo <= curLo)
        bool isInclusion = curContainsPrev or prevContainsCur

        if isInclusion
            // Merge: direction determines how
            if mc_dir >= 0
                // Uptrend merge: take higher high, higher low
                mc_hi := math.max(mc_hi, curHi)
                mc_lo := math.max(mc_lo, curLo)
            else
                // Downtrend merge: take lower high, lower low
                mc_hi := math.min(mc_hi, curHi)
                mc_lo := math.min(mc_lo, curLo)
            mc_barIdx := bar_index  // update representative
        else
            // No inclusion -> finalize current merged candle and start new one
            newMC_hi     := mc_hi
            newMC_lo     := mc_lo
            newMC_barIdx := mc_barIdx
            newMC_start  := mc_startIdx
            newMC_end    := bar_index - 1
            newMC_ready  := true

            // Determine new direction
            if curHi > mc_hi
                newMC_dir := 1
            else
                newMC_dir := -1
            mc_dir := newMC_dir

            // Start new merged candle
            mc_hi       := curHi
            mc_lo       := curLo
            mc_barIdx   := bar_index
            mc_startIdx := bar_index

// Store merged candle when ready
if newMC_ready
    mc = MergedCandle.new(newMC_hi, newMC_lo, newMC_barIdx, newMC_start, newMC_end, newMC_dir)
    array.push(mergedCandles, mc)

    // Optional: color merged candle bars
    if i_showMerged
        barcolor(newMC_dir > 0 ? color.new(color.lime, 60) : color.new(color.fuchsia, 60),
                 offset = bar_index - newMC_barIdx)

// ============================================================================
// MODULE 2: FRACTAL DETECTION (分型识别)
// ============================================================================

var int    lastFractalType = 0
var float  lastFractalHi   = na
var float  lastFractalLo   = na
var int    lastFractalBar  = na
newFractal_ready = false
var int    newFractal_type  = 0
var float  newFractal_hi    = na
var float  newFractal_lo    = na
var int    newFractal_bar   = na

if newMC_ready and array.size(mergedCandles) >= 3
    int sz = array.size(mergedCandles)
    MergedCandle mc1 = array.get(mergedCandles, sz - 3)
    MergedCandle mc2 = array.get(mergedCandles, sz - 2)  // center
    MergedCandle mc3 = array.get(mergedCandles, sz - 1)

    bool isTop    = mc2.hi > mc1.hi and mc2.hi > mc3.hi and mc2.lo > mc1.lo and mc2.lo > mc3.lo
    bool isBottom = mc2.hi < mc1.hi and mc2.hi < mc3.hi and mc2.lo < mc1.lo and mc2.lo < mc3.lo

    if isTop
        newFractal_ready := true
        newFractal_type  := 1
        newFractal_hi    := mc2.hi
        newFractal_lo    := mc2.lo
        newFractal_bar   := mc2.barIdx

    if isBottom
        newFractal_ready := true
        newFractal_type  := -1
        newFractal_hi    := mc2.hi
        newFractal_lo    := mc2.lo
        newFractal_bar   := mc2.barIdx

if newFractal_ready
    frac = Fractal.new(newFractal_type, newFractal_hi, newFractal_lo, newFractal_bar, true)
    array.push(fractals, frac)

    // Draw fractal marker
    if i_showFractals
        if newFractal_type == 1
            lbl = label.new(newFractal_bar, newFractal_hi, "▼",
                 style=label.style_none, textcolor=i_colSell, size=size.small)
            array.push(fracLabels, lbl)
        else if newFractal_type == -1
            lbl = label.new(newFractal_bar, newFractal_lo, "▲",
                 style=label.style_none, textcolor=i_colBuy, size=size.small)
            array.push(fracLabels, lbl)

// ============================================================================
// MODULE 3: STROKE / BI DETECTION (笔的识别)
// ============================================================================

// State for bi detection
var int    bi_lastDir     = 0       // direction of last confirmed stroke
var float  bi_lastTopHi   = na      // last top fractal high
var float  bi_lastTopLo   = na
var int    bi_lastTopBar  = na
var float  bi_lastBotHi   = na      // last bottom fractal high
var float  bi_lastBotLo   = na
var int    bi_lastBotBar  = na
var int    bi_pendingDir  = 0       // direction of pending (unconfirmed) stroke
var bool   bi_hasFirst    = false   // have we established the first fractal?
var int    bi_count       = 0

newBi_ready = false
var int    newBi_dir      = 0
var float  newBi_price    = na
var float  newBi_hi       = na
var float  newBi_lo       = na
var int    newBi_bar      = na
var float  newBi_startPrice = na
var int    newBi_startBar = na

if newFractal_ready
    ftype = newFractal_type
    fhi   = newFractal_hi
    flo   = newFractal_lo
    fbar  = newFractal_bar

    if not bi_hasFirst
        // Store first fractal as starting point
        if ftype == 1
            bi_lastTopHi  := fhi
            bi_lastTopLo  := flo
            bi_lastTopBar := fbar
        else
            bi_lastBotHi  := fhi
            bi_lastBotLo  := flo
            bi_lastBotBar := fbar
        bi_pendingDir := ftype
        bi_hasFirst   := true
    else
        // Minimum distance check
        int prevBar = bi_pendingDir == 1 ? bi_lastTopBar : bi_lastBotBar

        if ftype == bi_pendingDir
            // Same type fractal - check if more extreme -> update
            if ftype == 1 and fhi > bi_lastTopHi
                bi_lastTopHi  := fhi
                bi_lastTopLo  := flo
                bi_lastTopBar := fbar
            else if ftype == -1 and flo < bi_lastBotLo
                bi_lastBotHi  := fhi
                bi_lastBotLo  := flo
                bi_lastBotBar := fbar
        else
            // Opposite type fractal - try to form a stroke
            bool validBi = false

            if ftype == -1 and not na(bi_lastTopBar)
                // Potential down stroke: from top to bottom
                int dist = fbar - bi_lastTopBar
                if dist >= i_minBiBars and bi_lastTopHi > fhi and bi_lastTopLo > flo
                    validBi := true
            else if ftype == 1 and not na(bi_lastBotBar)
                // Potential up stroke: from bottom to top
                int dist = fbar - bi_lastBotBar
                if dist >= i_minBiBars and fhi > bi_lastBotHi and flo > bi_lastBotLo
                    validBi := true

            if validBi
                if ftype == -1
                    // Down stroke confirmed: top -> bottom
                    int fromBar = bi_lastTopBar
                    int toBar   = fbar
                    float mArea = calcMacdArea(fromBar, toBar)

                    // Record the top point if it's a new bi start
                    if bi_count == 0 or bi_lastDir != 1
                        topPt = BiPoint.new(1, bi_lastTopHi, bi_lastTopHi, bi_lastTopLo, bi_lastTopBar, 0.0)
                        array.push(biPoints, topPt)
                        bi_count += 1

                    // Record bottom point
                    botPt = BiPoint.new(-1, flo, fhi, flo, fbar, mArea)
                    array.push(biPoints, botPt)
                    bi_count += 1

                    newBi_ready      := true
                    newBi_dir        := -1
                    newBi_price      := flo
                    newBi_hi         := fhi
                    newBi_lo         := flo
                    newBi_bar        := fbar
                    newBi_startPrice := bi_lastTopHi
                    newBi_startBar   := bi_lastTopBar

                    bi_lastDir    := -1
                    bi_pendingDir := -1
                    bi_lastBotHi  := fhi
                    bi_lastBotLo  := flo
                    bi_lastBotBar := fbar

                else if ftype == 1
                    // Up stroke confirmed: bottom -> top
                    int fromBar = bi_lastBotBar
                    int toBar   = fbar
                    float mArea = calcMacdArea(fromBar, toBar)

                    if bi_count == 0 or bi_lastDir != -1
                        botPt = BiPoint.new(-1, bi_lastBotLo, bi_lastBotHi, bi_lastBotLo, bi_lastBotBar, 0.0)
                        array.push(biPoints, botPt)
                        bi_count += 1

                    topPt = BiPoint.new(1, fhi, fhi, flo, fbar, mArea)
                    array.push(biPoints, topPt)
                    bi_count += 1

                    newBi_ready      := true
                    newBi_dir        := 1
                    newBi_price      := fhi
                    newBi_hi         := fhi
                    newBi_lo         := flo
                    newBi_bar        := fbar
                    newBi_startPrice := bi_lastBotLo
                    newBi_startBar   := bi_lastBotBar

                    bi_lastDir    := 1
                    bi_pendingDir := 1
                    bi_lastTopHi  := fhi
                    bi_lastTopLo  := flo
                    bi_lastTopBar := fbar

            else
                // Not valid yet - update pending fractal if more extreme
                if ftype == 1
                    if na(bi_lastTopBar) or fhi > bi_lastTopHi
                        bi_lastTopHi  := fhi
                        bi_lastTopLo  := flo
                        bi_lastTopBar := fbar
                    bi_pendingDir := 1
                else
                    if na(bi_lastBotBar) or flo < bi_lastBotLo
                        bi_lastBotHi  := fhi
                        bi_lastBotLo  := flo
                        bi_lastBotBar := fbar
                    bi_pendingDir := -1

// Draw stroke line
if newBi_ready and i_showBi
    lineCol = newBi_dir > 0 ? i_colBiUp : i_colBiDn
    ln = line.new(newBi_startBar, newBi_startPrice, newBi_bar, newBi_price,
         color=lineCol, width=2, style=line.style_solid)
    array.push(biLines, ln)

// ============================================================================
// MODULE 4: PIVOT / HUB DETECTION (中枢识别)
// ============================================================================

var int    pvt_state       = 0       // 0=waiting, 1=building, 2=active
var float  pvt_ZG          = na      // pivot high
var float  pvt_ZD          = na      // pivot low
var int    pvt_startBar    = na
var int    pvt_endBar      = na
var int    pvt_strokeCount = 0
var int    pvt_dir         = 0
var float  pvt_entryHi     = na      // high of first stroke entering pivot
var float  pvt_entryLo     = na      // low of first stroke entering pivot
var float  pvt_exitHi      = na      // high of last stroke exiting pivot
var float  pvt_exitLo      = na      // low of last stroke exiting pivot
newPivot_ready   = false
newPivot_break   = false            // pivot broken (for B3/S3)
var int    newPivot_breakDir = 0    // 1=broke above, -1=broke below

if newBi_ready and array.size(biPoints) >= 4
    int bpSz = array.size(biPoints)

    if pvt_state == 0
        // Need at least 3 strokes (4 bi points) to form pivot overlap
        if bpSz >= 4
            // Take last 4 points to check for 3-stroke overlap
            BiPoint p1 = array.get(biPoints, bpSz - 4)
            BiPoint p2 = array.get(biPoints, bpSz - 3)
            BiPoint p3 = array.get(biPoints, bpSz - 2)
            BiPoint p4 = array.get(biPoints, bpSz - 1)

            // Strokes are: p1->p2, p2->p3, p3->p4
            // Find overlap zone
            float s1Hi = math.max(p1.hi, p2.hi)
            float s1Lo = math.min(p1.lo, p2.lo)
            float s2Hi = math.max(p2.hi, p3.hi)
            float s2Lo = math.min(p2.lo, p3.lo)
            float s3Hi = math.max(p3.hi, p4.hi)
            float s3Lo = math.min(p3.lo, p4.lo)

            float overlapHi = math.min(s1Hi, math.min(s2Hi, s3Hi))
            float overlapLo = math.max(s1Lo, math.max(s2Lo, s3Lo))

            if overlapHi > overlapLo
                pvt_state       := 2
                pvt_ZG          := overlapHi
                pvt_ZD          := overlapLo
                pvt_startBar    := p1.barIdx
                pvt_endBar      := p4.barIdx
                pvt_strokeCount := 3
                pvt_dir         := p1.dir
                pvt_entryHi     := math.max(p1.hi, p2.hi)
                pvt_entryLo     := math.min(p1.lo, p2.lo)
                pvt_exitHi      := math.max(p3.hi, p4.hi)
                pvt_exitLo      := math.min(p3.lo, p4.lo)
                newPivot_ready  := true

    else if pvt_state == 2
        // Active pivot: check if new stroke extends or breaks it
        BiPoint latest = array.get(biPoints, bpSz - 1)
        BiPoint prev   = array.get(biPoints, bpSz - 2)

        float strokeHi = math.max(latest.hi, prev.hi)
        float strokeLo = math.min(latest.lo, prev.lo)

        // Check overlap with existing pivot
        float newOverlapHi = math.min(pvt_ZG, strokeHi)
        float newOverlapLo = math.max(pvt_ZD, strokeLo)

        if newOverlapHi > newOverlapLo
            // Stroke overlaps -> extend pivot
            pvt_endBar      := latest.barIdx
            pvt_strokeCount += 1
            pvt_exitHi      := strokeHi
            pvt_exitLo      := strokeLo
        else
            // Stroke breaks pivot -> finalize and look for new one
            // Record break direction for B3/S3 detection
            if strokeLo > pvt_ZG
                newPivot_breakDir := 1   // broke above
            else if strokeHi < pvt_ZD
                newPivot_breakDir := -1  // broke below
            newPivot_break := true

            // Save completed pivot
            pvt = Pivot.new(pvt_ZG, pvt_ZD, pvt_startBar, pvt_endBar, pvt_strokeCount, pvt_dir)
            array.push(pivots, pvt)

            // Draw pivot box
            if i_showPivot
                bx = box.new(pvt_startBar, pvt_ZG, pvt_endBar, pvt_ZD,
                     border_color=color.new(color.orange, 50),
                     bgcolor=i_colPivot, border_width=1)
                array.push(pivotBoxes, bx)

            // Reset pivot state
            pvt_state       := 0
            pvt_ZG          := na
            pvt_ZD          := na
            pvt_startBar    := na
            pvt_endBar      := na
            pvt_strokeCount := 0

// ============================================================================
// MODULE 5: DIVERGENCE DETECTION (背驰判断)
// ============================================================================

var bool   divergence_detected = false
var int    divergence_type     = 0  // 1=bullish divergence, -1=bearish divergence
divergence_detected := false

if newBi_ready and array.size(biPoints) >= 4
    int bsz = array.size(biPoints)
    BiPoint curr = array.get(biPoints, bsz - 1)
    BiPoint prev = array.get(biPoints, bsz - 2)

    // Find the previous same-direction endpoint for comparison
    if bsz >= 4
        BiPoint prevSame = array.get(biPoints, bsz - 3)

        // Bearish divergence: price makes new high but MACD area decreases
        if curr.dir == 1 and prevSame.dir == 1
            if curr.price > prevSame.price
                // Calculate MACD areas
                BiPoint prevPrev = array.get(biPoints, bsz - 4)
                float currArea = curr.macdArea
                float prevArea = prevSame.macdArea > 0 ? prevSame.macdArea : calcMacdArea(prevPrev.barIdx, prevSame.barIdx)
                if prevArea > 0 and currArea < prevArea * 0.8
                    divergence_detected := true
                    divergence_type     := -1  // bearish

        // Bullish divergence: price makes new low but MACD area decreases
        if curr.dir == -1 and prevSame.dir == -1
            if curr.price < prevSame.price
                BiPoint prevPrev = array.get(biPoints, bsz - 4)
                float currArea = curr.macdArea
                float prevArea = prevSame.macdArea > 0 ? prevSame.macdArea : calcMacdArea(prevPrev.barIdx, prevSame.barIdx)
                if prevArea > 0 and currArea < prevArea * 0.8
                    divergence_detected := true
                    divergence_type     := 1   // bullish

    // Draw divergence label
    if divergence_detected and i_showDiverg
        divText = divergence_type == 1 ? "底背驰" : "顶背驰"
        divCol  = divergence_type == 1 ? i_colBuy : i_colSell
        yPos    = divergence_type == 1 ? curr.lo : curr.hi
        divStyle = divergence_type == 1 ? label.style_label_up : label.style_label_down
        lbl = label.new(curr.barIdx, yPos, divText,
             style=divStyle, color=color.new(divCol, 70),
             textcolor=divCol, size=size.small)
        array.push(divLabels, lbl)

// ============================================================================
// MODULE 6: BUY/SELL POINT IDENTIFICATION (买卖点)
// ============================================================================

var bool   sig_buy1  = false
var bool   sig_buy2  = false
var bool   sig_buy3  = false
var bool   sig_sell1 = false
var bool   sig_sell2 = false
var bool   sig_sell3 = false
var float  sig_price = na
var int    sig_bar   = na

// Reset signals each bar
sig_buy1  := false
sig_buy2  := false
sig_buy3  := false
sig_sell1 := false
sig_sell2 := false
sig_sell3 := false

// --- B1 / S1: Trend divergence buy/sell points ---
if divergence_detected and newBi_ready
    int bsz2 = array.size(biPoints)
    BiPoint curr2 = array.get(biPoints, bsz2 - 1)

    if divergence_type == 1 and curr2.dir == -1
        // B1: Bullish divergence at bottom of downtrend
        sig_buy1  := true
        sig_price := curr2.lo
        sig_bar   := curr2.barIdx
        sig = Signal.new(1, sig_price, sig_bar)
        array.push(signals, sig)

    if divergence_type == -1 and curr2.dir == 1
        // S1: Bearish divergence at top of uptrend
        sig_sell1 := true
        sig_price := curr2.hi
        sig_bar   := curr2.barIdx
        sig = Signal.new(-1, sig_price, sig_bar)
        array.push(signals, sig)

// --- B2 / S2: First pullback after B1/S1 ---
if newBi_ready and array.size(signals) >= 1 and array.size(biPoints) >= 2
    int bsz3 = array.size(biPoints)
    int ssz = array.size(signals)
    Signal lastSig = array.get(signals, ssz - 1)
    BiPoint curr3  = array.get(biPoints, bsz3 - 1)

    // B2: After a B1, the first pullback that doesn't make new low
    if lastSig.sigType == 1 and curr3.dir == -1 and curr3.barIdx > lastSig.barIdx
        if curr3.lo > lastSig.price
            sig_buy2  := true
            sig_price := curr3.lo
            sig_bar   := curr3.barIdx
            sig = Signal.new(2, sig_price, sig_bar)
            array.push(signals, sig)

    // S2: After a S1, the first rally that doesn't make new high
    if lastSig.sigType == -1 and curr3.dir == 1 and curr3.barIdx > lastSig.barIdx
        if curr3.hi < lastSig.price
            sig_sell2 := true
            sig_price := curr3.hi
            sig_bar   := curr3.barIdx
            sig = Signal.new(-2, sig_price, sig_bar)
            array.push(signals, sig)

// --- B3 / S3: Pivot breakout pullback ---
if newPivot_break and newBi_ready and array.size(biPoints) >= 2
    int bsz4 = array.size(biPoints)
    BiPoint curr4 = array.get(biPoints, bsz4 - 1)

    if array.size(pivots) >= 1
        Pivot lastPvt = array.get(pivots, array.size(pivots) - 1)

        // B3: After breaking above pivot, pullback doesn't re-enter pivot (stays above ZD)
        if newPivot_breakDir == 1 and curr4.dir == -1
            if curr4.lo > lastPvt.ZD
                sig_buy3  := true
                sig_price := curr4.lo
                sig_bar   := curr4.barIdx
                sig = Signal.new(3, sig_price, sig_bar)
                array.push(signals, sig)

        // S3: After breaking below pivot, rally doesn't re-enter pivot (stays below ZG)
        if newPivot_breakDir == -1 and curr4.dir == 1
            if curr4.hi < lastPvt.ZG
                sig_sell3 := true
                sig_price := curr4.hi
                sig_bar   := curr4.barIdx
                sig = Signal.new(-3, sig_price, sig_bar)
                array.push(signals, sig)

// --- Draw Buy/Sell Point Labels ---
if i_showSignals
    if sig_buy1
        lbl = label.new(sig_bar, sig_price, "B1\n一买",
             style=label.style_label_up, color=i_colBuy,
             textcolor=color.white, size=size.normal)
        array.push(sigLabels, lbl)
    if sig_buy2
        lbl = label.new(sig_bar, sig_price, "B2\n二买",
             style=label.style_label_up, color=color.new(i_colBuy, 30),
             textcolor=color.white, size=size.normal)
        array.push(sigLabels, lbl)
    if sig_buy3
        lbl = label.new(sig_bar, sig_price, "B3\n三买",
             style=label.style_label_up, color=color.new(i_colBuy, 50),
             textcolor=color.white, size=size.normal)
        array.push(sigLabels, lbl)
    if sig_sell1
        lbl = label.new(sig_bar, sig_price, "S1\n一卖",
             style=label.style_label_down, color=i_colSell,
             textcolor=color.white, size=size.normal)
        array.push(sigLabels, lbl)
    if sig_sell2
        lbl = label.new(sig_bar, sig_price, "S2\n二卖",
             style=label.style_label_down, color=color.new(i_colSell, 30),
             textcolor=color.white, size=size.normal)
        array.push(sigLabels, lbl)
    if sig_sell3
        lbl = label.new(sig_bar, sig_price, "S3\n三卖",
             style=label.style_label_down, color=color.new(i_colSell, 50),
             textcolor=color.white, size=size.normal)
        array.push(sigLabels, lbl)

// ============================================================================
// MODULE 7: STRATEGY EXECUTION
// ============================================================================

// Long entries
bool longEntry = false
if i_useBuy1 and sig_buy1
    longEntry := true
if i_useBuy2 and sig_buy2
    longEntry := true
if i_useBuy3 and sig_buy3
    longEntry := true

// Short entries / Long exits
bool shortEntry = false
if i_useSell1 and sig_sell1
    shortEntry := true
if i_useSell2 and sig_sell2
    shortEntry := true
if i_useSell3 and sig_sell3
    shortEntry := true

// Execute strategy
if longEntry
    if strategy.position_size < 0
        strategy.close("Short", comment="买点平空")
    strategy.entry("Long", strategy.long, comment="买入 Buy")

if shortEntry
    if strategy.position_size > 0
        strategy.close("Long", comment="卖点平多")
    if not i_longOnly
        strategy.entry("Short", strategy.short, comment="卖出 Sell")

// Stop loss
if strategy.position_size > 0
    float stopPrice = strategy.position_avg_price * (1 - i_stopLossPct / 100)
    if i_useTrailing
        strategy.exit("Long SL", "Long", stop=stopPrice,
             trail_price=strategy.position_avg_price * (1 + i_trailPct / 100),
             trail_offset=math.round(strategy.position_avg_price * i_trailPct / 100 / syminfo.mintick))
    else
        strategy.exit("Long SL", "Long", stop=stopPrice)

if strategy.position_size < 0
    float stopPrice = strategy.position_avg_price * (1 + i_stopLossPct / 100)
    if i_useTrailing
        strategy.exit("Short SL", "Short", stop=stopPrice,
             trail_price=strategy.position_avg_price * (1 - i_trailPct / 100),
             trail_offset=math.round(strategy.position_avg_price * i_trailPct / 100 / syminfo.mintick))
    else
        strategy.exit("Short SL", "Short", stop=stopPrice)

// ============================================================================
// MODULE 8: INFORMATION TABLE
// ============================================================================

var table infoTable = table.new(position.top_right, 2, 8,
     bgcolor=color.new(color.black, 80), border_width=1,
     border_color=color.new(color.gray, 50))

if barstate.islast
    table.cell(infoTable, 0, 0, "缠论策略", text_color=color.white, text_size=size.normal)
    table.cell(infoTable, 1, 0, "Chanlun Strategy", text_color=color.white, text_size=size.normal)

    table.cell(infoTable, 0, 1, "合并K线", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(array.size(mergedCandles)), text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 2, "分型", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(array.size(fractals)), text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 3, "笔", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(array.size(biPoints)), text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 4, "中枢", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(array.size(pivots)), text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 5, "信号", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 5, str.tostring(array.size(signals)), text_color=color.white, text_size=size.small)

    // Current position
    string posText = strategy.position_size > 0 ? "多 Long" : strategy.position_size < 0 ? "空 Short" : "无 None"
    color  posCol  = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray
    table.cell(infoTable, 0, 6, "持仓", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 6, posText, text_color=posCol, text_size=size.small)

    // Win rate
    float winRate = strategy.closedtrades > 0 ?
         strategy.wintrades / strategy.closedtrades * 100 : 0.0
    table.cell(infoTable, 0, 7, "胜率", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 7, str.tostring(winRate, "#.1") + "%", text_color=color.white, text_size=size.small)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(sig_buy1, title="B1 一买", message="缠论第一类买点 / Chanlun 1st Buy Point")
alertcondition(sig_buy2, title="B2 二买", message="缠论第二类买点 / Chanlun 2nd Buy Point")
alertcondition(sig_buy3, title="B3 三买", message="缠论第三类买点 / Chanlun 3rd Buy Point")
alertcondition(sig_sell1, title="S1 一卖", message="缠论第一类卖点 / Chanlun 1st Sell Point")
alertcondition(sig_sell2, title="S2 二卖", message="缠论第二类卖点 / Chanlun 2nd Sell Point")
alertcondition(sig_sell3, title="S3 三卖", message="缠论第三类卖点 / Chanlun 3rd Sell Point")
alertcondition(divergence_detected, title="背驰 Divergence", message="缠论背驰信号 / Chanlun Divergence Detected")
